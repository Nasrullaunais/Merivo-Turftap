{
  "name": "turftap",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@turftap/api' --filter '@turftap/portal' --filter '@turftap/console' dev",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run assistant:check",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write",
    "format:check": "prettier --check .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "gen": "bun run --filter '@turftap/api' openapi && bun run --filter '@turftap/contract' client",
    "db:generate": "bun run --filter '@turftap/api' db:generate",
    "db:migrate": "bun run --filter '@turftap/api' db:migrate",
    "db:seed": "bun run --filter '@turftap/api' db:seed",
    "whatsapp:link": "bun run --filter '@turftap/api' whatsapp:link",
    "whatsapp:unlink": "bun run --filter '@turftap/api' whatsapp:unlink",
    "whatsapp:templates": "bun run --filter '@turftap/api' whatsapp:templates",
    "tenant:create": "bun run --filter '@turftap/api' tenant:create",
    "tenant:off": "bun run --filter '@turftap/api' tenant:off",
    "tenant:on": "bun run --filter '@turftap/api' tenant:on",
    "tenants:list": "bun run --filter '@turftap/api' tenants:list",
    "admin:add": "bun run --filter '@turftap/api' admin:add",
    "assistant:setup": "bun n8n/setup.ts",
    "emulator": "bun run --filter '@turftap/chat-emulator' dev",
    "assistant:export": "bun n8n/export.ts",
    "assistant:check": "bun n8n/check-prompt.ts"
  },
  "devDependencies": {
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.5"
}
