{
  "name": "turftap",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@turftap/api' --filter '@turftap/portal' --filter '@turftap/console' dev",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write",
    "format:check": "prettier --check .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "gen": "bun run --filter '@turftap/api' openapi && bun run --filter '@turftap/contract' client",
    "db:generate": "bun run --filter '@turftap/api' db:generate",
    "db:migrate": "bun run --filter '@turftap/api' db:migrate",
    "db:seed": "bun run --filter '@turftap/api' db:seed"
  },
  "devDependencies": {
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.5"
}
