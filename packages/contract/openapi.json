              "type": "string",
              "enum": [
                "createdAt,asc",
                "createdAt,desc"
              ],
              "default": "createdAt,asc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "content",
                        "page",
                        "size",
                        "totalElements",
                        "totalPages"
                      ],
                      "properties": {
                        "content": {
                          "type": "array",
