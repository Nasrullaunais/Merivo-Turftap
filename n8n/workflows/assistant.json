    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// The answer to \"What's your name?\", without \"my name is\" and the like.\nconst MAX_NAME_LENGTH = 80;\nconst MAX_NAME_WORDS = 6;\nconst GREETINGS = /^(hi+|hello+|hey+|hai|good (morning|afternoon|evening)|ayubowan|vanakkam)$/i;\nconst askedBefore = $json.askedBefore === true;\nconst name = $('Gather').item.json.text\n  .replace(/\\s+/g, ' ')\n  .replace(/^(hi|hello)[,!.]?\\s+/i, '')\n  .replace(/^(my name is|my name's|i am|i'm|im|this is|it's|its)\\s+/i, '')\n  .replace(/[.!]+$/, '')\n  .trim();\nconst looksLikeName =\n  name.length > 0 &&\n  name.length <= MAX_NAME_LENGTH &&\n  /\\p{L}/u.test(name) &&\n  name.split(' ').length <= MAX_NAME_WORDS &&\n  !GREETINGS.test(name);\nreturn { json: { askedBefore, name: looksLikeName ? name : null } };"
      },
