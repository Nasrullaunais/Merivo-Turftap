    {
      "parameters": {
        "jsCode": "// Meta signs each delivery with the app secret; anything else may be someone pretending to be a customer.\nconst crypto = require('crypto');\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst sent = String($json.headers['x-hub-signature-256'] ?? '');\nconst expected = 'sha256=' + crypto.createHmac('sha256', $env.WHATSAPP_APP_SECRET).update(raw).digest('hex');\nconst valid = sent.length === expected.length && crypto.timingSafeEqual(Buffer.from(sent), Buffer.from(expected));\nreturn [{ json: { valid, body: valid ? JSON.parse(raw.toString('utf8')) : null } }];"
      },
