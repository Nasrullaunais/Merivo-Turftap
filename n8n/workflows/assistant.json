    {
      "parameters": {
        "jsCode": "// One item per customer message. Delivery and read receipts carry no messages and stop here.\nconst MAX_TEXT_LENGTH = 4096;\nconst SKIPPED_TYPES = new Set(['reaction']);\nconst items = [];\nfor (const entry of $json.body?.entry ?? []) {\n  for (const change of entry.changes ?? []) {\n    if (change.field !== 'messages') continue;\n    const value = change.value ?? {};\n    for (const message of value.messages ?? []) {\n      if (SKIPPED_TYPES.has(message.type)) continue;\n      const text = message.text?.body ?? message.image?.caption ?? '';\n      items.push({\n        json: {\n          phoneNumberId: String(value.metadata?.phone_number_id ?? ''),\n          waId: String(message.from),\n          phone: '+' + String(message.from).replace(/\\D/g, ''),\n          messageId: String(message.id),\n          type: String(message.type),\n          text: text.trim().slice(0, MAX_TEXT_LENGTH),\n          photoId: message.image?.id ?? null,\n        },\n      });\n    }\n  }\n}\nreturn items;"
      },
