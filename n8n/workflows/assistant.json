    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- AST-05: was this number asked its name in the last 30 minutes? Notes that it is being asked now.\nWITH forgotten AS (\n  DELETE FROM assistant_name_asks WHERE asked_at < now() - interval '30 minutes' AND session_id <> $1\n), earlier AS (\n  SELECT asked_at > now() - interval '30 minutes' AS asked FROM assistant_name_asks WHERE session_id = $1\n), noted AS (\n  INSERT INTO assistant_name_asks (session_id, asked_at) VALUES ($1, now())\n  ON CONFLICT (session_id) DO UPDATE SET asked_at = now()\n)\nSELECT coalesce((SELECT asked FROM earlier), false) AS \"askedBefore\";",
        "options": {
          "queryReplacement": "={{ [$json.sessionId] }}"
        }
      },
      "id": "db000000-0000-4000-8000-000000000019",
      "name": "Note Name Ask",
      "type": "n8n-nodes-base.postgres",
