    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const message = $('Read Messages').item.json;\nconst tenantId = $('Find Tenant').item.json.data.content[0].tenantId;\nconst tenantName = $('Read Tenant').item.json.data.name;\nconst venues = $('Find Venues').item.json.data.content;\nconst customer = $json.data.content[0] ?? null;\n\n// \"+94771234567\" reads as \"077 123 4567\" in Sri Lanka.\nconst localPhone = (phone) =>\n  phone.startsWith('+94') && phone.length === 12\n    ? '0' + phone.slice(3, 5) + ' ' + phone.slice(5, 8) + ' ' + phone.slice(8)\n    : phone;\n\n// AST-06: how to reach a person, finishing a sentence that starts with \"please\".\nlet callVenue;\nif (venues.length === 0) callVenue = 'contact ' + tenantName + ' directly.';\nelse if (venues.length === 1) callVenue = 'call ' + venues[0].name + ' on ' + localPhone(venues[0].phone) + '.';\nelse callVenue = 'call one of our venues:\\n' + venues.map((v) => '• ' + v.name + ': ' + localPhone(v.phone)).join('\\n');\n\nreturn { json: { ...message, tenantId, tenantName, sessionId: tenantId + ':' + message.phone, customer, callVenue } };"
      },
