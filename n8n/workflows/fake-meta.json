{
  "id": "turftapFakeMeta1",
  "name": "Pretend Meta (local only)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": ":phoneNumberId/messages",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "40000000-0000-4000-8000-000000000025",
      "name": "Send In",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "fake-meta"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "1f000000-0000-4000-8000-000000000027",
              "leftValue": "={{ $json.body?.type === 'text' && typeof $json.body?.text?.body === 'string' && typeof $json.body?.to === 'string' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1f000000-0000-4000-8000-000000000028",
      "name": "Is Text?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO fake_meta_messages (message_id, phone_number_id, to_wa_id, body)\nVALUES ('wamid.fake-' || gen_random_uuid(), $1, $2, $3)\nRETURNING message_id AS \"messageId\", to_wa_id AS \"to\";",
        "options": {
          "queryReplacement": "={{ [$json.params.phoneNumberId, $json.body.to, $json.body.text.body] }}"
        }
      },
      "id": "db000000-0000-4000-8000-000000000029",
      "name": "Keep Message",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        -100
      ],
      "credentials": {
        "postgres": {
          "id": "n8nOwnDatabase01",
          "name": "n8n database"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { messaging_product: 'whatsapp', contacts: [{ input: $json.to, wa_id: $json.to }], messages: [{ id: $json.messageId }] } }}",
        "options": {}
      },
      "id": "5e5d0000-0000-4000-8000-00000000002a",
      "name": "Answer Like Meta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        660,
        -100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { error: { message: '(#100) Pretend Meta only takes text messages so far', type: 'OAuthException', code: 100 } } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "5e5d0000-0000-4000-8000-00000000002b",
      "name": "Refuse Send",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        440,
        100
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fake-meta/inbox",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "40000000-0000-4000-8000-00000000002c",
      "name": "Inbox In",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        320
      ],
      "webhookId": "40000000-0000-4000-8000-00000000002d"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id::int AS id, message_id AS \"messageId\", body AS text, sent_at AS \"sentAt\"\nFROM fake_meta_messages\nWHERE phone_number_id = $1 AND to_wa_id = $2 AND id > $3\nORDER BY id\nLIMIT 100;",
        "options": {
          "queryReplacement": "={{ [String($json.body.phoneNumberId ?? ''), String($json.body.to ?? ''), Number($json.body.afterId ?? 0)] }}"
        }
      },
      "id": "db000000-0000-4000-8000-00000000002e",
      "name": "Load Inbox",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        320
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "n8nOwnDatabase01",
          "name": "n8n database"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { messages: $input.all().map((i) => i.json).filter((m) => m.messageId) } }}",
        "options": {}
      },
      "id": "5e5d0000-0000-4000-8000-00000000002f",
      "name": "Answer Inbox",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        440,
        320
      ]
    }
  ],
  "connections": {
    "Send In": {
      "main": [
        [
          {
            "node": "Is Text?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Text?": {
      "main": [
        [
          {
            "node": "Keep Message",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Refuse Send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Keep Message": {
      "main": [
        [
          {
            "node": "Answer Like Meta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Inbox In": {
      "main": [
        [
          {
            "node": "Load Inbox",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Inbox": {
      "main": [
        [
          {
            "node": "Answer Inbox",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all"
  },
  "pinData": {}
}
