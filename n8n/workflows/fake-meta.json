        "respondWith": "json",
        "responseBody": "={{ $json.body }}",
        "options": {
          "responseCode": "={{ $json.status }}"
        }
      },
      "id": "db380000-0000-4000-8000-000000000015",
      "name": "Refuse File",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        880,
        1100
      ]
    }
