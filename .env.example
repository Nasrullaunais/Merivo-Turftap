# Copy to .env and fill in. Every setting the API reads is listed here (apps/api/src/lib/config.ts).
# Secrets have no default: a missing one stops the API from starting.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://turftap:turftap@127.0.0.1:5433/turftap
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# The Staff Console's address, sent in staff invites.
CONSOLE_URL=http://localhost:5174

# fake | auth0. The fake accepts "Bearer fake:+94771234567" as a sign-in for that phone.
AUTH_PROVIDER=fake
AUTH_CACHE_SECONDS=300
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_PHONE_CLAIM=phone_number
# Auth0's phone provider sends it with each Login Code (infra/auth0). Needed when AUTH_PROVIDER=auth0.
AUTH0_HOOK_SECRET=
# n8n sends it as "Authorization: Assistant <key>" to act for a customer. At least 32 characters.
# Treat it like a database password. Make one with: openssl rand -hex 32
ASSISTANT_API_KEY=local-assistant-key-change-me-in-production

# fake | s3. Locally s3 means SeaweedFS from compose.yaml; production uses Cloudflare R2
# with S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com and S3_REGION=auto.
STORAGE_PROVIDER=fake
S3_ENDPOINT=http://127.0.0.1:8334
S3_REGION=us-east-1
S3_BUCKET=turftap
S3_ACCESS_KEY_ID=turftap
S3_SECRET_ACCESS_KEY=turftap-secret

# fake | whatsapp-cloud. whatsapp-cloud sends through Meta with the WHATSAPP_* values below
# (docs/architecture/deployment.md#whatsapp).
MESSAGING_PROVIDER=fake
# Only a fake exists so far.
SMS_PROVIDER=fake
# fake | gemini. gemini reads Transfer Receipts with GEMINI_API_KEY (below) and this model.
RECEIPT_READER=fake
RECEIPT_READER_MODEL=gemini-3.8-flash

# The Assistant in n8n (docs/architecture/assistant.md#settings). Locally the emulator signs
# messages with this app secret; live, both come from the Meta app.
WHATSAPP_APP_SECRET=local-whatsapp-app-secret
WHATSAPP_VERIFY_TOKEN=local-whatsapp-verify-token
# From the Meta app: a System User's access token and the TurfTap number's phone number id.
# The business account id is only for bun run whatsapp:templates.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# The Assistant's AI, and the receipt reader when RECEIPT_READER=gemini.
# bun run assistant:setup turns it into an n8n credential. Make one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Used by compose.yaml
POSTGRES_PASSWORD=turftap
POSTGRES_PORT=5433
S3_PORT=8334
N8N_PORT=5679

# Tests (bun test) always use this database, never DATABASE_URL.
TEST_DATABASE_URL=postgres://turftap:turftap@127.0.0.1:5433/turftap_test
# Set it to run the Gemini receipt reader's tests against Google; left empty, they are skipped.
TEST_GEMINI_API_KEY=
