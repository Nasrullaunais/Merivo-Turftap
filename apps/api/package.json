{
  "name": "@turftap/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "openapi": "bun --env-file=../../.env scripts/openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env scripts/migrate.ts",
    "db:seed": "bun --env-file=../../.env scripts/seed.ts",
    "whatsapp:link": "bun --env-file=../../.env scripts/whatsapp-link.ts",
    "whatsapp:unlink": "bun --env-file=../../.env scripts/whatsapp-unlink.ts",
    "whatsapp:templates": "bun --env-file=../../.env scripts/whatsapp-templates.ts",
    "tenant:create": "bun --env-file=../../.env scripts/tenant-create.ts",
    "tenant:off": "bun --env-file=../../.env scripts/tenant-off.ts",
    "tenant:on": "bun --env-file=../../.env scripts/tenant-on.ts",
    "tenants:list": "bun --env-file=../../.env scripts/tenants-list.ts",
    "admin:add": "bun --env-file=../../.env scripts/admin-add.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@google/genai": "^3.6.1",
    "@turftap/contract": "workspace:*",
    "drizzle-orm": "~0.45.4",
    "hono": "^4.13.19",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "pg-boss": "^12.39.0",
    "pino": "^10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "archunit": "2.5.5",
    "drizzle-kit": "~0.31.11"
  }
}
